      <attribute persist="false" config_key="[EffectRack1_EffectUnit4],group_[BusTalkover]_enable">0</attribute>
    </attributes>
  </manifest>

  <Schemes>
  <!-- TERMINAL-SCHEMES-BEGIN: generated by tools/terminal_skin/generate.py, do not edit -->
    <Scheme>
      <Name>Btop</Name>
      <!-- btop palette: black ground, sage-grey rules and text, and only the four sample hues (magenta, yellow, cyan, green). -->

      <LaunchImageStyle>
        LaunchImage {
          background-color: #000000;
        }
        QLabel {
          image: url(skins:Terminal/btop/style/mixxx_logo.svg);
          padding: 0;
          margin: 0px 2px 0px 2px;
          border: none;
          min-width: 315px;
          max-width: 315px;
          min-height: 80px;
          max-height: 80px;
        }
        QProgressBar {
          background: url(skins:Terminal/btop/style/progressbar_bg.svg);
          border: none;
          min-width: 319px;
          max-width: 319px;
          min-height: 5px;
          max-height: 5px;
        }
        QProgressBar::chunk {
          background: url(skins:Terminal/btop/style/progressbar.svg);
        }
      </LaunchImageStyle>

      <Style src="skins:Terminal/style_btop.qss"/>

      <!-- Asset subset. One directory per scheme, generated from the palette. -->
      <SetVariable name="BtnScheme">btop</SetVariable>
      <SetVariable name="KnobScheme">btop</SetVariable>
      <SetVariable name="SliderScheme">btop</SetVariable>
      <SetVariable name="StyleScheme">btop</SetVariable>

      <!-- Waveforms & overviews. These follow the palette, so a single-hue
           palette yields single-hue waveforms. -->
      <SetVariable name="BgColorOverview_12">#000000</SetVariable>
      <SetVariable name="BgColorOverview_34">#000000</SetVariable>
      <SetVariable name="BgColorOverview_SamPre">#000000</SetVariable>
      <SetVariable name="BgColorWaveform_12">#000000</SetVariable>
      <SetVariable name="BgColorWaveform_34">#000000</SetVariable>
      <SetVariable name="SignalColor_12">#93d64a</SetVariable>
      <SetVariable name="SignalColor_34">#42c9d6</SetVariable>

      <!-- Frequency bands, magenta/yellow/cyan in place of red/green/blue.
           Mixxx has two independent band triples: the Filtered and HSV
           renderers read Signal*Color, the RGB renderer and the deck overview
           read SignalRGB*Color. Both are set to the same three hues so the
           waveform and the overview match whichever type is selected. -->
      <SetVariable name="SignalLowColor">#ea3c96</SetVariable>
      <SetVariable name="SignalMidColor">#d8d84a</SetVariable>
      <SetVariable name="SignalHighColor">#42c9d6</SetVariable>
      <SetVariable name="SignalRGBLowColor">#ea3c96</SetVariable>
      <SetVariable name="SignalRGBMidColor">#d8d84a</SetVariable>
      <SetVariable name="SignalRGBHighColor">#42c9d6</SetVariable>

      <!-- Waveform/overview marker labels are reverse video: the chip takes
           the marker colour and the text takes the background. -->
      <SetVariable name="MarkTextColor">#000000</SetVariable>
      <SetVariable name="MarkDefaultColor">#929e8a</SetVariable>
      <SetVariable name="MarkDisabledColor">#6c7566</SetVariable>
      <SetVariable name="DurationTextColor">#ddf0d1</SetVariable>

      <SetVariable name="DimBrightThresholdOverview">127</SetVariable>
      <SetVariable name="DimBrightThresholdWaveform">105</SetVariable>
      <SetVariable name="DimBrightThresholdHotcueBtn">105</SetVariable>
      <SetVariable name="DndRectMarginHotcueBtn">1</SetVariable>

      <!-- Waveform furniture: thin dim rules, bright markers. -->
      <SetVariable name="AxesColor">#3b4037</SetVariable>
      <SetVariable name="BeatColor">#596154</SetVariable>
      <SetVariable name="PlayPosColor">#ddf0d1</SetVariable>
      <SetVariable name="CueColor">#ea3c96</SetVariable>
      <SetVariable name="LoopColor">#d8d84a</SetVariable>
      <SetVariable name="IntroOutroColor">#1d5c63</SetVariable>
      <SetVariable name="PlayedOverlayColor">#dd000000</SetVariable>
      <SetVariable name="EndOfTrackColor">#ea3c96</SetVariable>
      <SetVariable name="SlipBorderOutlineColor">#d8d84a</SetVariable>
      <SetVariable name="PassthroughLabelColor">#ea3c96</SetVariable>
      <SetVariable name="OverviewFontSizeDeck">12</SetVariable>
      <SetVariable name="OverviewFontSizeDeckMini">10</SetVariable>
      <SetVariable name="OverviewFontSizeSampler">9</SetVariable>
      <SetVariable name="OverviewFontSizePreview">8</SetVariable>

      <!-- Button frames are blank SVGs; the borders come from the stylesheet. -->
      <SetVariable name="TopRegion_BtnType">embedded</SetVariable>
      <SetVariable name="SubRegion_BtnType">embedded</SetVariable>

      <!-- Knobs. The bezel SVG is blank too: what you see is the value arc
           over a dim background arc, plus a block needle. -->
      <SetVariable name="PotiMinAngle">-130</SetVariable>
      <SetVariable name="PotiMaxAngle">130</SetVariable>
      <SetVariable name="ArcRadiusBig">14.5</SetVariable>
      <SetVariable name="ArcRadiusCompact">12.5</SetVariable>
      <SetVariable name="ArcRadiusSmall">12.0</SetVariable>
      <SetVariable name="ArcThicknessBig">3</SetVariable>
      <SetVariable name="ArcBgThickness">3</SetVariable>
      <SetVariable name="ArcBgColor">#596154</SetVariable>
      <!-- Square caps: a terminal meter has no rounded ends. -->
      <SetVariable name="ArcRoundCaps">false</SetVariable>
      <SetVariable name="ArcColorEq">#b7c7ad</SetVariable>
      <SetVariable name="ArcColorGain">#d8d84a</SetVariable>
      <SetVariable name="ArcColorFx12Quick">#93d64a</SetVariable>
      <SetVariable name="ArcColorFx34">#42c9d6</SetVariable>
      <SetVariable name="ArcColorFxParameter">#b7c7ad</SetVariable>
      <SetVariable name="ArcColorGainLow">#d8d84a</SetVariable>
      <SetVariable name="ArcColorMstBal">#ea3c96</SetVariable>
      <SetVariable name="ArcColorFxMix">#ea3c96</SetVariable>
      <!-- Needle image suffixes; each resolves to a palette colour. -->
      <SetVariable name="KnobColorEq">grey</SetVariable>
      <SetVariable name="KnobColorQuickEffect">green</SetVariable>
      <SetVariable name="KnobColorFx12">green</SetVariable>
      <SetVariable name="KnobColorFx34">blue</SetVariable>
      <SetVariable name="KnobColorFxParameter">grey</SetVariable>
      <SetVariable name="EqKillDotSize">9f,9f</SetVariable>

      <!-- Fader level bars, drawn by the widget rather than by an image. -->
      <SetVariable name="BarBgColor">#000000</SetVariable>
      <SetVariable name="BarColorVolume">#93d64a</SetVariable>
      <SetVariable name="BarColorCrossfader">#93d64a</SetVariable>
      <SetVariable name="BarColorPitch">#929e8a</SetVariable>
      <SetVariable name="BarWidth">2</SetVariable>
      <SetVariable name="BarMarginVolume">8,8</SetVariable>
      <SetVariable name="BarMarginPitch">7,8</SetVariable>
      <SetVariable name="BarMarginPitchSampler">5,5</SetVariable>
      <SetVariable name="BarMarginCrossfader">7,7</SetVariable>
    </Scheme><!-- Btop -->

