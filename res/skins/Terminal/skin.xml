      <SetVariable name="TopRegion_BtnType">embedded</SetVariable>
      <SetVariable name="SubRegion_BtnType">embedded</SetVariable>

      <!-- Knobs. The bezel SVG is blank too: what you see is the value arc
           over a dim background arc, plus a block needle. -->
      <SetVariable name="PotiMinAngle">-130</SetVariable>
      <SetVariable name="PotiMaxAngle">130</SetVariable>
      <SetVariable name="ArcRadiusBig">14.5</SetVariable>
      <SetVariable name="ArcRadiusCompact">12.5</SetVariable>
      <SetVariable name="ArcRadiusSmall">12.0</SetVariable>
      <SetVariable name="ArcThicknessBig">3</SetVariable>
      <SetVariable name="ArcBgThickness">3</SetVariable>
      <SetVariable name="ArcBgColor">#246626</SetVariable>
      <!-- Square caps: a terminal meter has no rounded ends. -->
      <SetVariable name="ArcRoundCaps">false</SetVariable>
      <SetVariable name="ArcColorEq">#33ff3a</SetVariable>
      <SetVariable name="ArcColorGain">#33ff3a</SetVariable>
      <SetVariable name="ArcColorFx12Quick">#33ff3a</SetVariable>
      <SetVariable name="ArcColorFx34">#33ff3a</SetVariable>
      <SetVariable name="ArcColorFxParameter">#33ff3a</SetVariable>
      <SetVariable name="ArcColorGainLow">#33ff3a</SetVariable>
      <SetVariable name="ArcColorMstBal">#33ff3a</SetVariable>
      <SetVariable name="ArcColorFxMix">#33ff3a</SetVariable>
      <!-- Needle image suffixes; each resolves to a palette colour. -->
      <SetVariable name="KnobColorEq">grey</SetVariable>
      <SetVariable name="KnobColorQuickEffect">green</SetVariable>
      <SetVariable name="KnobColorFx12">green</SetVariable>
      <SetVariable name="KnobColorFx34">blue</SetVariable>
      <SetVariable name="KnobColorFxParameter">grey</SetVariable>
      <SetVariable name="EqKillDotSize">9f,9f</SetVariable>

      <!-- Fader level bars, drawn by the widget rather than by an image. -->
      <SetVariable name="BarBgColor">#000000</SetVariable>
      <SetVariable name="BarColorVolume">#33ff3a</SetVariable>
      <SetVariable name="BarColorCrossfader">#33ff3a</SetVariable>
      <SetVariable name="BarColorPitch">#1fd625</SetVariable>
      <SetVariable name="BarWidth">2</SetVariable>
      <SetVariable name="BarMarginVolume">8,8</SetVariable>
      <SetVariable name="BarMarginPitch">7,8</SetVariable>
      <SetVariable name="BarMarginPitchSampler">5,5</SetVariable>
      <SetVariable name="BarMarginCrossfader">7,7</SetVariable>
    </Scheme><!-- Green Phosphor -->

    <Scheme>
      <Name>White Phosphor</Name>
      <!-- P4 white phosphor: one barely-blue white, separated by brightness alone, like a paper-white monitor. -->

      <LaunchImageStyle>
        LaunchImage {
          background-color: #000000;
        }
        QLabel {
          image: url(skins:Terminal/white/style/mixxx_logo.svg);
          padding: 0;
          margin: 0px 2px 0px 2px;
          border: none;
          min-width: 315px;
          max-width: 315px;
          min-height: 80px;
          max-height: 80px;
        }
        QProgressBar {
          background: url(skins:Terminal/white/style/progressbar_bg.svg);
          border: none;
          min-width: 319px;
          max-width: 319px;
          min-height: 5px;
          max-height: 5px;
        }
        QProgressBar::chunk {
          background: url(skins:Terminal/white/style/progressbar.svg);
        }
      </LaunchImageStyle>

      <Style src="skins:Terminal/style_white.qss"/>

      <!-- Asset subset. One directory per scheme, generated from the palette. -->
      <SetVariable name="BtnScheme">white</SetVariable>
      <SetVariable name="KnobScheme">white</SetVariable>
      <SetVariable name="SliderScheme">white</SetVariable>
      <SetVariable name="StyleScheme">white</SetVariable>

      <!-- Waveforms & overviews. These follow the palette, so a single-hue
           palette yields single-hue waveforms. -->
      <SetVariable name="BgColorOverview_12">#000000</SetVariable>
      <SetVariable name="BgColorOverview_34">#000000</SetVariable>
      <SetVariable name="BgColorOverview_SamPre">#000000</SetVariable>
      <SetVariable name="BgColorWaveform_12">#000000</SetVariable>
      <SetVariable name="BgColorWaveform_34">#000000</SetVariable>
      <SetVariable name="SignalColor_12">#e4e6e7</SetVariable>
      <SetVariable name="SignalColor_34">#939a9f</SetVariable>

      <!-- Frequency bands, magenta/yellow/cyan in place of red/green/blue.
           Mixxx has two independent band triples: the Filtered and HSV
           renderers read Signal*Color, the RGB renderer and the deck overview
           read SignalRGB*Color. Both are set to the same three hues so the
           waveform and the overview match whichever type is selected. -->
      <SetVariable name="SignalLowColor">#939a9f</SetVariable>
      <SetVariable name="SignalMidColor">#e4e6e7</SetVariable>
      <SetVariable name="SignalHighColor">#f7f7f8</SetVariable>
      <SetVariable name="SignalRGBLowColor">#939a9f</SetVariable>
      <SetVariable name="SignalRGBMidColor">#e4e6e7</SetVariable>
      <SetVariable name="SignalRGBHighColor">#f7f7f8</SetVariable>

      <!-- Waveform/overview marker labels are reverse video: the chip takes
           the marker colour and the text takes the background. -->
      <SetVariable name="MarkTextColor">#000000</SetVariable>
      <SetVariable name="MarkDefaultColor">#939a9f</SetVariable>
      <SetVariable name="MarkDisabledColor">#666f75</SetVariable>
      <SetVariable name="DurationTextColor">#f7f7f8</SetVariable>

      <SetVariable name="DimBrightThresholdOverview">127</SetVariable>
      <SetVariable name="DimBrightThresholdWaveform">105</SetVariable>
      <SetVariable name="DimBrightThresholdHotcueBtn">105</SetVariable>
      <SetVariable name="DndRectMarginHotcueBtn">1</SetVariable>

      <!-- Waveform furniture: thin dim rules, bright markers. -->
      <SetVariable name="AxesColor">#32383c</SetVariable>
      <SetVariable name="BeatColor">#4d555b</SetVariable>
      <SetVariable name="PlayPosColor">#f7f7f8</SetVariable>
      <SetVariable name="CueColor">#e4e6e7</SetVariable>
      <SetVariable name="LoopColor">#e4e6e7</SetVariable>
      <SetVariable name="IntroOutroColor">#666f75</SetVariable>
      <SetVariable name="PlayedOverlayColor">#dd000000</SetVariable>
      <SetVariable name="EndOfTrackColor">#e4e6e7</SetVariable>
      <SetVariable name="SlipBorderOutlineColor">#e4e6e7</SetVariable>
      <SetVariable name="PassthroughLabelColor">#e4e6e7</SetVariable>
      <SetVariable name="OverviewFontSizeDeck">12</SetVariable>
      <SetVariable name="OverviewFontSizeDeckMini">10</SetVariable>
      <SetVariable name="OverviewFontSizeSampler">9</SetVariable>
      <SetVariable name="OverviewFontSizePreview">8</SetVariable>

      <!-- Button frames are blank SVGs; the borders come from the stylesheet. -->
      <SetVariable name="TopRegion_BtnType">embedded</SetVariable>
      <SetVariable name="SubRegion_BtnType">embedded</SetVariable>

      <!-- Knobs. The bezel SVG is blank too: what you see is the value arc
           over a dim background arc, plus a block needle. -->
      <SetVariable name="PotiMinAngle">-130</SetVariable>
      <SetVariable name="PotiMaxAngle">130</SetVariable>
      <SetVariable name="ArcRadiusBig">14.5</SetVariable>
      <SetVariable name="ArcRadiusCompact">12.5</SetVariable>
      <SetVariable name="ArcRadiusSmall">12.0</SetVariable>
      <SetVariable name="ArcThicknessBig">3</SetVariable>
      <SetVariable name="ArcBgThickness">3</SetVariable>
      <SetVariable name="ArcBgColor">#4d555b</SetVariable>
      <!-- Square caps: a terminal meter has no rounded ends. -->
      <SetVariable name="ArcRoundCaps">false</SetVariable>
      <SetVariable name="ArcColorEq">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorGain">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorFx12Quick">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorFx34">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorFxParameter">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorGainLow">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorMstBal">#e4e6e7</SetVariable>
      <SetVariable name="ArcColorFxMix">#e4e6e7</SetVariable>
      <!-- Needle image suffixes; each resolves to a palette colour. -->
      <SetVariable name="KnobColorEq">grey</SetVariable>
      <SetVariable name="KnobColorQuickEffect">green</SetVariable>
      <SetVariable name="KnobColorFx12">green</SetVariable>
      <SetVariable name="KnobColorFx34">blue</SetVariable>
      <SetVariable name="KnobColorFxParameter">grey</SetVariable>
      <SetVariable name="EqKillDotSize">9f,9f</SetVariable>

      <!-- Fader level bars, drawn by the widget rather than by an image. -->
      <SetVariable name="BarBgColor">#000000</SetVariable>
      <SetVariable name="BarColorVolume">#e4e6e7</SetVariable>
      <SetVariable name="BarColorCrossfader">#e4e6e7</SetVariable>
      <SetVariable name="BarColorPitch">#939a9f</SetVariable>
      <SetVariable name="BarWidth">2</SetVariable>
      <SetVariable name="BarMarginVolume">8,8</SetVariable>
      <SetVariable name="BarMarginPitch">7,8</SetVariable>
      <SetVariable name="BarMarginPitchSampler">5,5</SetVariable>
      <SetVariable name="BarMarginCrossfader">7,7</SetVariable>
    </Scheme><!-- White Phosphor -->

  <!-- TERMINAL-SCHEMES-END -->
  </Schemes>

  <ObjectName>Mixxx</ObjectName>
  <Style src="skins:Terminal/style.qss"
         src-linux="skins:default-menu-styles-linux.qss"
         src-windows="skins:default-menu-styles-windows.qss"/>
  <!-- MinimumSize should not be an exact monitor resolution. There needs
  to be space for the title bar or other chrome at full screen.
  https://www.mixxx.org/wiki/doku.php/skin_guidelines#the_optimal_size_for_skins -->
  <MinimumSize>1280,668</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>
  <Children>

    <SetVariable name="Align">center</SetVariable>

    <!-- Define singletons as early in the skin as possible.
    Note that Singletons don't actually appear here, they are just instantiated
    and configured. -->
    <SingletonDefinition>
      <ObjectName>Deck1_Src</ObjectName>
      <Children>
      <Template src="skins:Terminal/decks/deck.xml">
        <SetVariable name="ChanNum">1</SetVariable>
        <SetVariable name="DeckGroup">12</SetVariable>
        <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
        <SetVariable name="BgColor"><Variable name="BgColorOverview_12"/></SetVariable>
      </Template>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>Deck2_Src</ObjectName>
      <Children>
        <Template src="skins:Terminal/decks/deck.xml">
          <SetVariable name="ChanNum">2</SetVariable>
          <SetVariable name="DeckGroup">12</SetVariable>
          <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
          <SetVariable name="BgColor"><Variable name="BgColorOverview_12"/></SetVariable>
        </Template>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>Deck3_Src</ObjectName>
      <Children>
      <Template src="skins:Terminal/decks/deck.xml">
        <SetVariable name="ChanNum">3</SetVariable>
        <SetVariable name="DeckGroup">34</SetVariable>
        <SetVariable name="SignalColor"><Variable name="SignalColor_34"/></SetVariable>
        <SetVariable name="BgColor"><Variable name="BgColorOverview_34"/></SetVariable>
      </Template>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>Deck4_Src</ObjectName>
      <Children>
      <Template src="skins:Terminal/decks/deck.xml">
        <SetVariable name="ChanNum">4</SetVariable>
        <SetVariable name="DeckGroup">34</SetVariable>
        <SetVariable name="SignalColor"><Variable name="SignalColor_34"/></SetVariable>
        <SetVariable name="BgColor"><Variable name="BgColorOverview_34"/></SetVariable>
      </Template>
      </Children>
    </SingletonDefinition>

    <Template src="skins:Terminal/mixer/singletons.xml"/>

    <SingletonDefinition>
      <ObjectName>LibrarySingleton</ObjectName>
      <Children>
        <Template src="skins:Terminal/library.xml"/>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>SamplerSettingsSingleton</ObjectName>
      <Children>
        <Template src="skins:Terminal/helpers/skin_settings_samplers.xml"/>
      </Children>
    </SingletonDefinition>

    <WidgetGroup>
      <ObjectName>SkinContainer</ObjectName>
      <Layout>vertical</Layout>
      <SizePolicy>me,me</SizePolicy>
      <Children>

        <Template src="skins:Terminal/toolbar.xml"/>

        <!-- regular/maximized library  |  skin settings menu -->
        <WidgetGroup>
          <Layout>horizontal</Layout>
          <SizePolicy>me,me</SizePolicy>
          <Children>

            <!-- regular or maximized library -->
            <WidgetStack currentpage="[Skin],show_maximized_library">
              <Children>

                <!-- Waveforms, Decks, Effects... /  Library
                This view needs to be set up first because it instantiates
                the mini deck Singletons we need in maximized library view. -->
                <Splitter>
                  <ObjectName>WaveformSplitter</ObjectName>
                  <Orientation>vertical</Orientation>
                  <SizePolicy>me,min</SizePolicy>
                  <SplitSizes>100,550</SplitSizes>
                  <SplitSizesConfigKey>[Skin],stackedWaveforms_splitSize</SplitSizesConfigKey>
                  <Collapsible>0,0</Collapsible>
                  <Children>

                    <WidgetGroup>
                      <Layout>vertical</Layout>
                      <SizePolicy>me,me</SizePolicy>
                      <Children>
                        <Template src="skins:Terminal/waveforms_container.xml"/>
                      </Children>
                      <Connection>
                        <ConfigKey persist="true">[Skin],show_waveforms</ConfigKey>
                        <BindProperty>visible</BindProperty>
                      </Connection>
                    </WidgetGroup>

                    <WidgetGroup>
                      <ObjectName>DecksMixerContainer</ObjectName>
                      <Layout>vertical</Layout>
                      <SizePolicy>me,me</SizePolicy>
                      <Children>
                        <WidgetGroup><!-- Top spacer when waveforms are hidden -->
                          <ObjectName>ToolbarDeckSpacer</ObjectName>
                          <Connection>
                            <ConfigKey persist="true">[Skin],show_waveforms</ConfigKey>
                            <Transform><Not/></Transform>
                            <BindProperty>visible</BindProperty>
                          </Connection>
                        </WidgetGroup><!-- ToolbarDeckSpacer -->

                        <WidgetGroup>
                          <Layout>horizontal</Layout>
                          <SizePolicy>me,max</SizePolicy>
                          <Children>
                            <Template src="skins:Terminal/decks/decks_left.xml"/>
                            <Template src="skins:Terminal/mixer.xml"/>
                            <Template src="skins:Terminal/decks/decks_right.xml"/>
                          </Children>
                        </WidgetGroup>

                        <Template src="skins:Terminal/fx_rack.xml"/>
                        <Template src="skins:Terminal/samplers_rack.xml"/>
                        <Template src="skins:Terminal/mic_aux_rack.xml"/>

                        <SingletonContainer>
                          <ObjectName>LibrarySingleton</ObjectName>
                        </SingletonContainer>
                      </Children>
                    </WidgetGroup>

                  </Children>
                </Splitter>
                <!-- Decks, Effects, Samplers, Mic/Aux, Library -->

                <!-- Maximized Library & mini decks only -->
                <WidgetGroup trigger="[Skin],show_maximized_library" on_hide_select="0">
                  <Layout>vertical</Layout>
                  <SizePolicy>me,me</SizePolicy>
                  <Children>

                    <WidgetGroup>
                      <Layout>horizontal</Layout>
                      <SizePolicy>me,max</SizePolicy>
                      <Children>
                        <Template src="skins:Terminal/decks/decks_left_mini.xml"/>
                        <Template src="skins:Terminal/decks/decks_right_mini.xml"/>
                      </Children>
                      <Connection>
                        <ConfigKey persist="true">[Terminal],max_lib_show_decks</ConfigKey>
                        <BindProperty>visible</BindProperty>
                      </Connection>
                    </WidgetGroup>

                    <SingletonContainer>
                      <ObjectName>LibrarySingleton</ObjectName>
                    </SingletonContainer>
                  </Children>
                </WidgetGroup><!-- Maximized Library & mini decks only -->

              </Children>
            </WidgetStack>
            <Template src="skins:Terminal/skin_settings.xml"/>

          </Children>
        </WidgetGroup><!-- regular/maximized library + skin settings menu -->

      </Children>
    </WidgetGroup>
  </Children>
</skin>
