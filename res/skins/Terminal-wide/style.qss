/* Terminal-wide // structure: typography, geometry, layout margins.
 *
 * Colour lives in style_<scheme>.qss, which Mixxx appends after this file, so
 * everything here is deliberately colour-free. Sizes are picked for an 8.8"
 * 1920x480 panel viewed at arm's length: extra large readable typography and generous touch targets.
 */

/************** font *********************************************************/

#Mixxx,
WWidget,
WLabel,
WNumber, WNumberPos, WNumberRate,
WPushButton,
WKey,
WTime,
WTrackProperty,
WRateRange,
WSearchLineEdit,
WCueMenuPopup,
WCueMenuPopup QLabel,
WCueMenuPopup QLineEdit,
WOverview,
WTrackTableView,
WLibrarySidebar,
WLibraryTextBrowser,
WTrackTableViewHeader,
WTrackTableViewHeader::section,
WEffectSelector,
WEffectSelector QAbstractScrollArea,
WEffectSelector QAbstractItemView,
WEffectChainPresetSelector,
WEffectChainPresetSelector QAbstractScrollArea,
WEffectChainPresetSelector QAbstractItemView,
WEffectChainPresetButton,
WEffectChainPresetButton QMenu,
QMenu,
QToolTip {
  font-family: "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "Menlo", monospace;
  font-weight: normal;
  font-style: normal;
  text-transform: none;
}

/************** toolbar ******************************************************/

#ToolBar {
  padding: 3px 6px;
}

#TabControls WPushButton,
#ToolBarOptions WPushButton {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 0px 3px;
}

#ClockTime {
  font-size: 24px;
  margin-left: 8px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

/************** deck column **************************************************/

#DeckPanelLeft {
  margin: 2px 3px 2px 2px;
  padding: 2px 6px;
}

#DeckPanelRight {
  margin: 2px 2px 2px 3px;
  padding: 2px 6px;
}

#DeckHeader {
  margin-bottom: 2px;
}

#DeckLabel {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#DeckFieldLabel {
  font-size: 19px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignBottom';
}

#DeckTitle {
  font-size: 32px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#DeckTime {
  font-size: 46px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#DeckBpmBox {
  margin-left: 8px;
  padding: 0px 8px;
}

#DeckBpmCaption {
  font-size: 19px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#DeckRateBox {
  margin-left: 8px;
}

#DeckBpm {
  font-size: 44px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#DeckKeySteps {
  font-size: 23px;
  padding-left: 4px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#DeckRate {
  font-size: 29px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#DeckRateSign {
  font-size: 23px;
  qproperty-alignment: 'AlignCenter';
}

#DeckRateRange {
  font-size: 23px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#DeckKey {
  font-size: 29px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/************** deck buttons *************************************************/

#DeckTransport WPushButton,
#DvsControlsRow WPushButton {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 3px 0px;
}

#DeckTransport,
#DvsControls {
  margin-top: 4px;
}

/************** deck rows: hot cues, loop, beatjump **************************/

#DeckHotcueRow,
#DeckLoopJumpRow {
  margin-top: 3px;
}

#DeckHotcueRow WPushButton,
#DeckLoopJumpRow WPushButton {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 3px 0px;
}

#DeckLoopJumpRow #LoopActivate {
  font-size: 54px;
}

#DeckLoopJumpRow #JumpBack,
#DeckLoopJumpRow #JumpForward {
  font-size: 40px;
}

#LoopSize, #JumpSize {
  font-size: 24px;
  font-weight: bold;
  margin: 1px;
  padding: 0px 6px;
  qproperty-alignment: 'AlignCenter';
}

#LoopSize::up-button, #LoopSize::down-button,
#JumpSize::up-button, #JumpSize::down-button,
#LoopSize::up-arrow, #LoopSize::down-arrow,
#JumpSize::up-arrow, #JumpSize::down-arrow {
  width: 0px;
  height: 0px;
  border: none;
}

#DvsStatusLight {
  font-size: 21px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 0px;
}

/************** fx page ******************************************************/

#FxUnitTabs {
  margin: 2px 0px 0px 0px;
}

#FxUnitTabButton {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 0px 4px;
  padding: 3px 0px;
}

#FxUnitPanel {
  margin: 2px 4px 4px 4px;
  padding: 4px 8px;
}

#FxUnitLabel {
  font-size: 27px;
  font-weight: bold;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#FxRouteLabel {
  font-size: 20px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#FxUnitHeader WPushButton,
#FxSlotEnable {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 3px 0px;
}

#FxSelector {
  font-size: 24px;
  margin: 1px 4px;
  padding: 3px 10px;
}

#FxSelector QAbstractItemView::item {
  min-height: 50px;
}

#FxPresetSelector {
  font-size: 22px;
  margin: 1px 4px;
  padding: 3px 10px;
}

#FxPresetSelector QAbstractItemView::item {
  min-height: 50px;
}

#FxPresetButton {
  font-size: 24px;
  font-weight: bold;
  margin: 1px;
  padding: 0px;
}

#FxPresetButton::menu-indicator {
  subcontrol-origin: margin;
  subcontrol-position: center center;
}

#FxPresetButton QMenu::item {
  padding: 12px 20px;
}

#FxKnobLabel {
  font-size: 19px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignHCenter | AlignTop';
}

#FxSlotColumn {
  margin: 1px 3px;
  padding: 2px 4px;
}

#FxSlotButtonParams,
#FxSlotKnobParamsRow1,
#FxSlotKnobParamsRow2 {
  margin-top: 4px;
}

#FxSlotButtonParams WPushButton {
  font-size: 21px;
  font-weight: bold;
  margin: 1px;
  padding: 3px 0px;
}

#FxKnobBox, #FxButtonBox {
  margin: 0px 1px;
}

/************** waveforms ****************************************************/

#WaveformColumn {
  margin: 2px 0px;
}

#WaveformBox1,
#WaveformBox2 {
  margin: 1px 0px;
}

#WaveformCols #WaveformBox1,
#WaveformCols #WaveformBox2 {
  margin: 0px 1px;
}

#OverviewRow {
  margin-top: 2px;
}

#OverviewBox1, #OverviewFrame1 {
  margin-right: 1px;
}

#OverviewBox2, #OverviewFrame2 {
  margin-left: 1px;
}

#OverviewFullRow {
  margin: 2px 2px 0px 2px;
}

#OverviewFullBox1, #OverviewFullBox1 #OverviewFrame1 {
  margin-right: 1px;
}

#OverviewFullBox2, #OverviewFullBox2 #OverviewFrame2 {
  margin-left: 1px;
}

#DeckOverviewBox {
  margin-top: 4px;
}

#DeckOverviewBox #OverviewFrame1,
#DeckOverviewBox #OverviewFrame2 {
  margin: 0px;
}

/************** library ******************************************************/

#LibraryPage {
  margin: 2px;
}

#SearchRow {
  margin-bottom: 2px;
}

WSearchLineEdit {
  font-size: 28px;
  padding: 8px 10px;
}

WLibrarySidebar {
  font-size: 24px;
}

WTrackTableView {
  font-size: 24px;
}

WTrackTableViewHeader::section {
  font-size: 20px;
  text-transform: lowercase;
  padding: 6px 8px;
}

#LibraryContainer QScrollBar:vertical {
  width: 22px;
}

#LibraryContainer QScrollBar:horizontal {
  height: 22px;
}

/************** menus, popups, tooltips **************************************/

QMenu, QMenu::item,
WTrackMenu, WTrackMenu QMenu,
WCueMenuPopup, WCueMenuPopup QLabel, WCueMenuPopup QLineEdit,
WLibrarySidebar QMenu,
WTrackTableViewHeader QMenu,
WSearchLineEdit QMenu,
QToolTip {
  font-size: 22px;
}

QMenu::item {
  padding: 14px 24px;
}

/************** options page *************************************************/

#OptionsPage {
  margin: 8px 12px;
}

#OptionsColumn {
  margin-right: 24px;
}

#OptionsSection {
  font-size: 22px;
  font-weight: bold;
  text-transform: lowercase;
  margin-bottom: 4px;
  qproperty-alignment: 'AlignLeft | AlignBottom';
}

#OptionRow {
  margin: 1px 0px;
}

#OptionCaption {
  font-size: 24px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#OptionRow WPushButton {
  font-size: 24px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 3px 0px;
}

#OptionsNote {
  font-size: 19px;
  text-transform: lowercase;
  margin-top: 6px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}
