  <!-- TERMINAL-WIDE-SCHEMES-END -->
  </Schemes>

  <ObjectName>Mixxx</ObjectName>
  <Style src="skin:style.qss"
         src-linux="skins:default-menu-styles-linux.qss"
         src-windows="skins:default-menu-styles-windows.qss"/>
  <!-- The panel is 1920x480. A minimum below that leaves room for a title bar
       when this is run in a window rather than full screen on the appliance. -->
  <MinimumSize>1024,400</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>

  <Children>
    <!-- Singletons are resolved in parse order, so every definition has to come
         before the container that asks for it. The overviews are defined first
         because the decks page - defined below - contains containers for them.
    -->
    <!-- The track overviews are singletons for a different reason: not to
         survive a page switch, but because the options page can put them
         either under the waveforms or inside the deck columns, and one widget
         that moves beats two widgets that take turns being hidden. -->
    <SingletonDefinition>
      <ObjectName>Overview1_Singleton</ObjectName>
      <Children>
        <Template src="skin:overview.xml">
          <SetVariable name="ChanNum">1</SetVariable>
          <SetVariable name="WaveSignalColor"><Variable name="SignalColor_1"/></SetVariable>
        </Template>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>Overview2_Singleton</ObjectName>
      <Children>
        <Template src="skin:overview.xml">
          <SetVariable name="ChanNum">2</SetVariable>
          <SetVariable name="WaveSignalColor"><Variable name="SignalColor_2"/></SetVariable>
        </Template>
      </Children>
    </SingletonDefinition>

    <!-- Pages are singletons so that a tab switch does not tear one down and
         rebuild it. -->
    <!-- The tab bar. It sits inside each page rather than above the stack, so
         that on the decks page it can run only the width of the waveform
         column and leave the deck columns the full height of the panel. One
         instance moves between the pages; only one page is ever visible. -->
    <SingletonDefinition>
      <ObjectName>ToolBar_Singleton</ObjectName>
      <Children>
        <Template src="skin:toolbar.xml"/>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>DecksPage_Singleton</ObjectName>
      <Children>
        <Template src="skin:decks.xml"/>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>LibraryPage_Singleton</ObjectName>
      <Children>
        <Template src="skin:library.xml"/>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>FxPage_Singleton</ObjectName>
      <Children>
        <Template src="skin:fx.xml"/>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>OptionsPage_Singleton</ObjectName>
      <Children>
        <Template src="skin:options.xml"/>
      </Children>
    </SingletonDefinition>

    <WidgetGroup>
      <ObjectName>SkinContainer</ObjectName>
      <Layout>vertical</Layout>
      <SizePolicy>me,me</SizePolicy>
      <Children>

        <WidgetStack currentpage="[Tab],current" persist="true">
          <ObjectName>PageStack</ObjectName>
          <SizePolicy>me,me</SizePolicy>
          <Children>
            <SingletonContainer trigger="[Tab],decks">
              <ObjectName>DecksPage_Singleton</ObjectName>
            </SingletonContainer>
            <SingletonContainer trigger="[Tab],library" on_hide_select="0">
              <ObjectName>LibraryPage_Singleton</ObjectName>
            </SingletonContainer>
            <SingletonContainer trigger="[Tab],fx" on_hide_select="0">
              <ObjectName>FxPage_Singleton</ObjectName>
            </SingletonContainer>
            <SingletonContainer trigger="[Tab],options" on_hide_select="0">
              <ObjectName>OptionsPage_Singleton</ObjectName>
            </SingletonContainer>
          </Children>
        </WidgetStack>

      </Children>
    </WidgetGroup>
  </Children>
</skin>
