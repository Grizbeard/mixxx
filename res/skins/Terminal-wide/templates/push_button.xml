<!DOCTYPE template>
<!--
  Description:
    A momentary deck button: one state, fires its control on press.

  Variables:
    ObjectName: the object name, which is what the stylesheet colours it by
    TooltipId:  Mixxx tooltip id
    Text:       the label
    Size:       the button size
    ConfigKey:  control to fire
-->
<Template>
  <PushButton>
    <ObjectName><Variable name="ObjectName"/></ObjectName>
    <TooltipId><Variable name="TooltipId"/></TooltipId>
    <Size><Variable name="Size"/></Size>
    <NumberStates>1</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="Text"/></Text>
    </State>
    <Connection>
      <ConfigKey><Variable name="ConfigKey"/></ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
  </PushButton>
</Template>
