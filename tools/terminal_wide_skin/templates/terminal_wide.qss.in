/* Terminal-wide -- the design layer.
 *
 * Appended after the skin's own style.qss, which carries geometry and type and
 * no colour at all. Double-brace placeholders resolve from the active palette;
 * every colour here has to be a token, never a literal, or the skin stops being
 * recolourable.
 *
 * Two rules of thumb, carried over from Terminal:
 *   1. A terminal draws chrome with 1px rules and solid blocks -- no gradient,
 *      no rounded corner, no bevel.
 *   2. "On" means reverse video: the accent fills the cell and the label turns
 *      the colour of the background.
 *
 * Unlike Terminal this skin has no inherited donor stylesheet underneath it and
 * no icon assets, so these rules are the whole of the colour. Everything is
 * text on a block.
 */

/* ---------------------------------------------------------------- ground -- */
#Mixxx,
#SkinContainer,
#PageStack,
#DecksPage,
#DeckFiller,
#ToolBarFiller {
  background-color: {{bg}};
}

/* Square everything. Lowest specificity, so anything below can opt out. */
* {
  border-radius: 0px;
}

/* ------------------------------------------------------------- box rules -- */
/* The three regions of the mixing page get a box each, the way btop frames
   every panel. All are expanding containers, so a border costs no fixed px. */
#DeckPanelLeft,
#DeckPanelRight,
#WaveformBox1, #WaveformBox2,
#OverviewFrame1, #OverviewFrame2,
#SidebarBox,
#SearchLineBox {
  background-color: {{panel}};
  border: 1px solid {{border}};
}

#ToolBar {
  background-color: {{bg}};
  border: none;
  border-bottom: 1px solid {{border}};
}

/* ------------------------------------------------------------- fx page -- */
#FxPage,
#FxBody {
  background-color: {{bg}};
}

#OverviewFullRow,
#OverviewFullBody,
#OverviewFullBox1,
#OverviewFullBox2,
#DecksRow {
  background-color: {{bg}};
}

#FxUnitPanel {
  background-color: {{panel}};
  border: 1px solid {{border}};
}

#FxUnitLabel {
  color: {{fx}};
  background: transparent;
}

#FxRouteLabel,
#FxKnobLabel {
  color: {{fg_dim}};
  background: transparent;
}

/* The unit's own on switch is the loudest thing on the page: with it off
   nothing else on the panel does anything. */
#Mixxx WPushButton#FxUnitEnable[displayValue="1"],
#Mixxx WPushButton#FxUnitTabButton[displayValue="1"] {
  background-color: {{fx}};
  color: {{bg}};
}

#Mixxx WPushButton#FxSlotEnable[displayValue="1"] {
  background-color: {{accent}};
  color: {{bg}};
}

/* A button parameter is a choice the effect offers, not a control of the
   skin's, so it takes the same treatment as any other latched button: dim
   block off, the effect hue on. Mixxx hides the ones the loaded effect does
   not have, so a row of these is exactly as long as that effect is. */
#Mixxx WEffectPushButton#FxParamButton[displayValue="0"] {
  background-color: {{block}};
  color: {{fg}};
}

#Mixxx WEffectPushButton#FxParamButton[displayValue="1"] {
  background-color: {{fx}};
  color: {{bg}};
}

#FxSlotColumn,
#FxSlotHeadRow,
#FxSlotButtonParams,
#FxSlotKnobParamsRow1,
#FxSlotKnobParamsRow2,
#FxKnobBox,
#FxButtonBox,
#FxParamFiller,
#FxMetaBox {
  background-color: {{panel}};
}

/* Routing is a statement about a deck, so it takes that deck's waveform
   colour and says which one it means without being read. */
#Mixxx WPushButton#FxRouteButton[displayValue="1"] {
  background-color: {{deck12}};
  color: {{bg}};
}

/* Mix mode is a selector - dry/wet against dry+wet, neither of them "on" -
   so it keeps one block in both states and lets the label carry it. */
#Mixxx WPushButton#FxMixMode[displayValue="0"],
#Mixxx WPushButton#FxMixMode[displayValue="1"] {
  background-color: {{block}};
  color: {{fg}};
}

WEffectSelector#FxSelector {
  background-color: {{block}};
  border: 1px solid {{border}};
  color: {{fg}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
}

WEffectSelector#FxSelector:hover {
  border-color: {{fx}};
  color: {{fg_hi}};
}

/* The drop-down list is a top-level popup, not a child of the combo box in the
   usual sense, so it needs naming both ways round - through the scroll area
   and through the item view - or its current row falls back to the platform
   highlight, which on Windows is the OS accent colour and has nothing to do
   with the scheme. */
WEffectSelector#FxSelector QAbstractScrollArea,
WEffectSelector QAbstractItemView,
WEffectSelector#FxSelector QAbstractItemView {
  background-color: {{panel}};
  border: 1px solid {{border_lit}};
  color: {{fg}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
  outline: none;
}

WEffectSelector QAbstractItemView::item {
  color: {{fg}};
  background-color: {{panel}};
}

WEffectSelector QAbstractItemView::item:selected,
WEffectSelector QAbstractItemView::item:hover {
  background-color: {{select}};
  color: {{select_text}};
}

/* --------------------------------------------------------- chain presets -- */
/* The preset selector is the same object as an effect selector as far as the
   eye is concerned, so it gets the same treatment - including naming the popup
   both ways round, since a combo's drop-down is a top-level widget and picks up
   the platform highlight otherwise. */
WEffectChainPresetSelector#FxPresetSelector {
  background-color: {{block}};
  border: 1px solid {{border}};
  color: {{fg}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
}

WEffectChainPresetSelector#FxPresetSelector:hover {
  border-color: {{fx}};
  color: {{fg_hi}};
}

WEffectChainPresetSelector QAbstractScrollArea,
WEffectChainPresetSelector QAbstractItemView {
  background-color: {{panel}};
  border: 1px solid {{border_lit}};
  color: {{fg}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
  outline: none;
}

WEffectChainPresetSelector QAbstractItemView::item {
  color: {{fg}};
  background-color: {{panel}};
}

WEffectChainPresetSelector QAbstractItemView::item:selected,
WEffectChainPresetSelector QAbstractItemView::item:hover {
  background-color: {{select}};
  color: {{select_text}};
}

/* The menu button is navigation, not a latched control - it has no on state to
   show - so it keeps one block whatever happens. */
#Mixxx WEffectChainPresetButton#FxPresetButton {
  background-color: {{block}};
  border: none;
  color: {{fg}};
}

#Mixxx WEffectChainPresetButton#FxPresetButton:hover {
  background-color: {{block_hi}};
  color: {{fg_hi}};
}

WEffectChainPresetButton QMenu {
  background-color: {{panel}};
  border: 1px solid {{border_lit}};
  color: {{fg}};
}

WEffectChainPresetButton QMenu::item:selected {
  background-color: {{select}};
  color: {{select_text}};
}

WEffectChainPresetButton QMenu::separator {
  background-color: {{border}};
  height: 1px;
  margin: 2px 0px;
}

/* The deck header is the panel's status line: recessed, with the deck name and
   the timecode state on it. It lights up while the deck is playing, which is
   the only play indicator this skin has. */
#DeckHeader {
  background-color: {{sunken}};
  border-bottom: 1px solid {{border}};
}

#DeckHeader[highlight="1"] {
  border-bottom: 1px solid {{play}};
}

#DeckHeader[highlight="1"] #DeckLabel {
  color: {{play}};
}

/* ------------------------------------------------------------ typography -- */
/* Captions are dim lowercase words; values are bright. */
#DeckFieldLabel,
#DeckRateSign,
#DeckRateRange,
#DeckKeySteps,
WTrackTableViewHeader,
WTrackTableViewHeader::section {
  color: {{fg_dim}};
  background: transparent;
}

#DeckLabel {
  color: {{fg_dim}};
  background: transparent;
}

WNumber, WNumberPos, WNumberRate, WKey, WTime,
#DeckTime, #DeckRate, #DeckKey {
  color: {{fg_hi}};
  background: transparent;
}

/* The bpm block is the exception to "full accent is for engaged controls".
   It is the number that decides what happens in the next few seconds, and on a
   panel read at arm's length across a booth it has to be findable without
   looking for it - so it takes the filled box and knocks the ink out, the same
   reverse video an engaged button gets. Nothing else on the deck does. */
#DeckBpmBox {
  background-color: {{accent}};
}

#DeckBpm,
#DeckBpmCaption {
  color: {{bg}};
  background: transparent;
}

WTrackProperty,
#DeckTitle {
  color: {{fg}};
  background: transparent;
}

#DeckArtist {
  color: {{fg_dim}};
  background: transparent;
}

/* Counting down rather than up. The highlight property is bound to
   ShowDurationRemaining, so this is the one state where the big number means
   something different from what it usually means. */
#DeckTime[highlight="1"] {
  color: {{loop}};
}

/* --------------------------------------------------------------- buttons -- */
/* A button is a solid block: no border, no bevel, no gradient. The 1px margin
   in style.qss lets the black ground show through and do all the separating.

   Off is one dim block for every button, whatever it does. Forty dim hues read
   as noise; one does not. On is the control's hue at full strength with the
   label flipped to the background colour. */
#Mixxx WPushButton {
  border: none;
  color: {{fg}};
}

#Mixxx WPushButton[displayValue="0"] {
  background-color: {{block}};
  color: {{fg}};
}

#Mixxx WPushButton:hover {
  background-color: {{block_hi}};
  color: {{fg_hi}};
}

#Mixxx WPushButton[displayValue="1"] {
  background-color: {{accent}};
  color: {{bg}};
}

#Mixxx WPushButton[displayValue="1"]:hover {
  background-color: {{fg_hi}};
  color: {{bg}};
}

/* Deck controls get their own hues, so "engaged" says which thing is engaged
   without reading the word. */
#Mixxx WPushButton#PlayDeck[displayValue="1"] {
  background-color: {{play}};
  color: {{bg}};
}

#Mixxx WPushButton#CueDeck[displayValue="1"] {
  background-color: {{cue}};
  color: {{bg}};
}

#Mixxx WPushButton#SyncDeck[displayValue="1"] {
  background-color: {{sync}};
  color: {{bg}};
}

#Mixxx WPushButton#KeylockDeck[displayValue="1"],
#Mixxx WPushButton#QuantizeDeck[displayValue="1"] {
  background-color: {{key}};
  color: {{bg}};
}

#Mixxx WPushButton#VinylEnableButton[displayValue="1"] {
  background-color: {{vinyl}};
  color: {{bg}};
}

/* Passthrough routes the analogue signal straight past Mixxx. It is the one
   state on this page where what you hear is not what the waveform shows, so it
   gets the loudest colour in the palette. */
#Mixxx WPushButton#VinylPassthroughButton[displayValue="1"] {
  background-color: {{rec}};
  color: {{bg}};
}

/* Mode selectors, not on/off switches. Absolute against relative against
   constant, needle-drop against cue against hotcue: every state is an equally
   valid choice and none of them is "engaged", so filling one with the accent
   claims an on state for a control that has no off -- and the bright block
   then drowns out the only thing that distinguishes the modes, which is the
   word on it. Leave the block alone in every state and let the label carry it. */
#Mixxx WPushButton#VinylModeButton[displayValue="0"],
#Mixxx WPushButton#VinylModeButton[displayValue="1"],
#Mixxx WPushButton#VinylModeButton[displayValue="2"],
#Mixxx WPushButton#VinylCueButton[displayValue="0"],
#Mixxx WPushButton#VinylCueButton[displayValue="1"],
#Mixxx WPushButton#VinylCueButton[displayValue="2"] {
  background-color: {{block}};
  color: {{fg}};
}

/* Navigation, not performance. The page tabs and the display toggles sit
   shoulder to shoulder across the top; a full-accent fill merges them into one
   bright band. Give them the muted selection colour and let the deck controls
   own the loud hues. */
#Mixxx #TabControls WPushButton[displayValue="1"] {
  background-color: {{select}};
  color: {{select_text}};
}

#Mixxx #TabControls WPushButton[displayValue="0"] {
  background-color: {{bg}};
  color: {{fg_dim}};
}

/* ----------------------------------------------------------- options page -- */
/* An option button cycles rather than latches, so none of its states is "on"
   and filling one with the accent would claim otherwise. Give every state the
   muted selection colour and let the word on the button - "two rows", "440 px",
   "in each deck" - be the readout. The four-state rows need states 2 and 3
   named explicitly; without them they fall through to the bare WPushButton
   rule and render with no fill at all. */
#Mixxx #OptionRow WPushButton[displayValue="0"],
#Mixxx #OptionRow WPushButton[displayValue="1"],
#Mixxx #OptionRow WPushButton[displayValue="2"],
#Mixxx #OptionRow WPushButton[displayValue="3"] {
  background-color: {{select}};
  color: {{select_text}};
}

#Mixxx #OptionRow WPushButton:hover {
  background-color: {{block_hi}};
  color: {{fg_hi}};
}

#OptionsSection {
  color: {{accent}};
  background: transparent;
}

#OptionCaption {
  color: {{fg}};
  background: transparent;
}

#OptionsNote {
  color: {{fg_faint}};
  background: transparent;
}

#OptionsPage,
#OptionsColumn,
#OptionsFiller {
  background-color: {{bg}};
}

/* A hot cue slot that is empty reads as a slot, not as a control: same dim
   block as everything else off, but the number in the faint ink so a row of
   four empties does not look like four things you could press. Set and active
   take the cue hue. On a monochrome scheme <UseCueColor> is off, so these
   rules are the whole of a hotcue's colour.

   With <UseCueColor> on, a set hotcue's background comes from the cue itself
   and overrides the rule below; these two are what a monochrome scheme, which
   turns that off, renders a hotcue with. */
#Mixxx WPushButton#HotcueButton[displayValue="0"] {
  background-color: {{block}};
  color: {{fg_faint}};
}

#Mixxx WPushButton#HotcueButton[displayValue="1"],
#Mixxx WPushButton#HotcueButton[displayValue="2"] {
  background-color: {{cue}};
  color: {{bg}};
}

/* The loop toggle is the one control on this row with a state, and that state
   is "a loop is running" - worth the loop hue at full strength. The two jump
   arrows are momentary and stay blocks. */
#Mixxx WPushButton#LoopActivate[displayValue="1"] {
  background-color: {{loop}};
  color: {{bg}};
}

#Mixxx WPushButton#JumpBack[displayValue="0"],
#Mixxx WPushButton#JumpForward[displayValue="0"] {
  background-color: {{block}};
  color: {{fg}};
}

WBeatSpinBox {
  background-color: {{sunken}};
  border: 1px solid {{border}};
  color: {{fg_hi}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
}

/* The two lengths are the row's reason for existing - everything else on it is
   feedback about a button the controller owns - so they get the filled box with
   the ink knocked out, and each takes its family's hue: loop the loop hue,
   beatjump its own. A sunken box with a border reads as a field you are meant
   to type in, which these are not; a filled one reads as a readout, and the hue
   says which of the two you are looking at without reading the number at all.
   On a one-hue scheme the two come out the same colour, which is as much as a
   single hue can say. */
#LoopSize {
  background-color: {{loop}};
  border: none;
  color: {{bg}};
  selection-background-color: {{bg}};
  selection-color: {{loop}};
}

#JumpSize {
  background-color: {{jump}};
  border: none;
  color: {{bg}};
  selection-background-color: {{bg}};
  selection-color: {{jump}};
}

WBeatSpinBox:focus {
  border-color: {{accent}};
}

WBeatSpinBox::up-button, WBeatSpinBox::down-button {
  background-color: {{raised}};
  border: none;
  border-left: 1px solid {{border}};
}

WBeatSpinBox::up-button:hover, WBeatSpinBox::down-button:hover {
  background-color: {{border}};
}

/* ------------------------------------------------------------ dvs status -- */
/* The one widget on screen that reports the timecode path, so it has to be
   readable at a glance on every palette -- including the monochrome ones,
   where hue cannot carry it. Each state is therefore a different *treatment*
   as well as a different colour, and they get louder in order: dark and faint,
   outlined, dim fill, full reverse video. On a single-hue scheme the fill and
   the outline still separate cleanly; on btop they also separate by hue. */
#DvsStatusLight[displayValue="0"] {
  background-color: {{block}};
  border: 1px solid {{border}};
  color: {{fg_faint}};
}

#DvsStatusLight[displayValue="1"] {
  background-color: {{block}};
  border: 1px solid {{green}};
  color: {{green}};
}

#DvsStatusLight[displayValue="2"] {
  background-color: {{yellow_dim}};
  border: 1px solid {{yellow}};
  color: {{fg_hi}};
}

#DvsStatusLight[displayValue="3"] {
  background-color: {{magenta}};
  border: 1px solid {{magenta}};
  color: {{bg}};
}

/* --------------------------------------------------------------- library -- */
WLibrary,
WLibraryTableView,
WTrackTableView {
  background-color: {{sunken}};
  alternate-background-color: {{panel}};
  color: {{fg}};
  border: 1px solid {{border}};
  gridline-color: {{border}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
  outline: none;
}

/* The track colour column is painted by ColorDelegate straight onto the
   viewport, so no rule here can reach it -- but the delegate reads this
   property first and falls back to the row background when it is set. That is
   the only handle a skin has on it, and it is what keeps a track's colour from
   being the one coloured thing on a monochrome screen. */
WTrackTableView {
  qproperty-mixxxColorDelegateUseRowBackgroundForColorCell: {{hide_track_color}};
}

WTrackTableView::item:selected,
WLibraryTableView::item:selected {
  background-color: {{select}};
  color: {{select_text}};
}

WTrackTableView::item:hover,
WLibraryTableView::item:hover {
  background-color: {{raised}};
  color: {{fg_hi}};
}

WTrackTableViewHeader,
WTrackTableViewHeader::section {
  background-color: {{bg}};
  color: {{fg_dim}};
  border: none;
  border-right: 1px solid {{border}};
  border-bottom: 1px solid {{border}};
}

WTrackTableViewHeader::section:hover {
  color: {{fg_hi}};
  background-color: {{raised}};
}

WLibrarySidebar {
  background-color: {{sunken}};
  color: {{fg}};
  border: none;
  outline: none;
  show-decoration-selected: 0;
}

WLibrarySidebar::item:selected,
WLibrarySidebar::branch:selected {
  background-color: {{select}};
  color: {{select_text}};
}

WLibrarySidebar::item:hover {
  background-color: {{raised}};
  color: {{fg_hi}};
}

/* The search field as a prompt line: no box, just a rule underneath. */
WSearchLineEdit {
  background-color: {{sunken}};
  color: {{fg_hi}};
  border: none;
  border-bottom: 1px solid {{border}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
}

WSearchLineEdit:focus {
  border-bottom-color: {{accent}};
}

#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton {
  color: {{fg_dim}};
  background: transparent;
  text-transform: lowercase;
}

#LibraryFeatureControls QPushButton {
  background-color: {{raised}};
  border: 1px solid {{border}};
  color: {{fg}};
  text-transform: lowercase;
}

#LibraryFeatureControls QPushButton:hover {
  border-color: {{border_lit}};
  color: {{fg_hi}};
}

#LibraryFeatureControls QPushButton:checked {
  background-color: {{accent}};
  border-color: {{accent}};
  color: {{bg}};
}

/* ------------------------------------------------------------ scrollbars -- */
QScrollBar:vertical, QScrollBar:horizontal {
  background-color: {{sunken}};
  border: none;
  margin: 0px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background-color: {{border_lit}};
  border: none;
  min-height: 40px;
  min-width: 40px;
}

QScrollBar::handle:hover {
  background-color: {{fg_dim}};
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
  border: none;
  height: 0px;
  width: 0px;
}

/* ----------------------------------------------------------- combo boxes -- */
QComboBox,
QSpinBox {
  background-color: {{raised}};
  border: 1px solid {{border}};
  color: {{fg}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
}

QComboBox:hover,
QSpinBox:hover {
  border-color: {{border_lit}};
  color: {{fg_hi}};
}

QComboBox QAbstractItemView {
  background-color: {{panel}};
  border: 1px solid {{border_lit}};
  color: {{fg}};
  selection-background-color: {{select}};
  selection-color: {{select_text}};
}

/* ------------------------------------------------------------- menu bar -- */
/* Mixxx loads the platform's default menu styles before this file, which
   deliberately leaves the menu bar looking native. A terminal has no native
   chrome, so take it over: flat, square, reverse-video highlight. */
#MainMenu,
QMenuBar {
  background-color: {{bg}};
  color: {{fg_dim}};
  border: none;
  border-bottom: 1px solid {{border}};
}

#MainMenu::item,
QMenuBar::item {
  background: transparent;
  color: {{fg_dim}};
  padding: 3px 8px;
}

#MainMenu::item:selected, #MainMenu::item:pressed,
QMenuBar::item:selected, QMenuBar::item:pressed {
  background-color: {{select}};
  color: {{select_text}};
}

/* ----------------------------------------------------- menus and popups -- */
QMenu, WCueMenuPopup, WTrackMenu {
  background-color: {{panel}};
  border: 1px solid {{border_lit}};
  color: {{fg}};
}

/* A menu is the hardest thing to hit on a touchscreen, and Mixxx puts a lot
   behind the track context menu. Give every row a finger's worth of height. */
QMenu::item {
  padding: 8px 16px;
}

QMenu::item:selected, QMenu::item:hover {
  background-color: {{select}};
  color: {{select_text}};
}

QMenu::item:disabled {
  color: {{fg_faint}};
}

QMenu::separator {
  background-color: {{border}};
  height: 1px;
  margin: 2px 0px;
}

QToolTip {
  background-color: {{sunken}};
  border: 1px solid {{accent}};
  color: {{fg}};
  padding: 3px;
}

/* ------------------------------------------------------------- splitters -- */
QSplitter::handle,
#LibrarySplitter::handle {
  background-color: {{bg}};
  width: 6px;
}

QSplitter::handle:hover {
  background-color: {{border_lit}};
}

/* --------------------------------------------------------------- overlays -- */
QProgressBar {
  background-color: {{sunken}};
  border: 1px solid {{border}};
  color: {{fg}};
  text-align: center;
}

QProgressBar::chunk {
  background-color: {{accent}};
}
